{
  "dependencies": {
    "preline": "^4.2.0",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "npm run watch:css & npm run watch:ts & wait",
    "watch:css": "tailwindcss -i ./src/index.css -o ./assets/css/output.css --watch",
    "watch:ts": "tsc -p tsconfig.json --watch",
    "build": "npm run build:css && npm run build:ts && node scripts/stage-site.mjs",
    "build:css": "tailwindcss -i ./src/index.css -o ./assets/css/output.css --minify",
    "build:ts": "tsc -p tsconfig.json"
  },
  "name": "green-market",
  "type": "module",
  "version": "1.0.0",
  "description": "Green Market — good food, close to home.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Houngmingyeak/NexaShop-mini-project.git"
  },
  "keywords": [],
